<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>pdsa</AssemblyName>
    <RootNamespace>PdsaCli</RootNamespace>
    <!-- 기본 버전(태그 없을 때). CI 는 태그에서 -p:Version=<ver> 로 덮어쓴다. -->
    <Version>0.0.1</Version>

    <!--
      배포: Native AOT 단일 네이티브 실행 파일 → npm(@webnori/pdsa)으로 게시.
      각 OS 러너에서 해당 RID 로 publish(호스트=타깃 전제):
        dotnet publish src/pdsa-cli -c Release -r win-x64   -p:Version=0.0.1   (Windows)
        dotnet publish src/pdsa-cli -c Release -r linux-x64 -p:Version=0.0.1   (Linux)
        dotnet publish src/pdsa-cli -c Release -r osx-arm64 -p:Version=0.0.1   (macOS Apple Silicon)
      Akka.NET 은 명시적 Config(ConfigurationFactory.Default)로 ConfigurationManager 경로를
      우회하면 AOT 에서 동작한다(AkkaPdsaEngine 참고). 네이티브 Kùzu 는 P/Invoke 로 이용
      (native/Kuzu.targets 가 호스트 플랫폼 lib 를 자동 다운로드/포함).
    -->
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <IlcTrimMetadata>false</IlcTrimMetadata>
  </PropertyGroup>

  <ItemGroup>
    <!-- Akka 기반 PDSA 엔진 + Kùzu 그래프 저장소/리더를 재사용(Core 라이브러리) -->
    <ProjectReference Include="..\AkkaGraphLoop.Core\AkkaGraphLoop.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- `pdsa init` 이 설치하는 스킬 문서를 실행 파일에 임베드(AOT-safe 매니페스트 리소스).
         SDK 기본 glob 이 .md 를 None 으로 잡으므로 먼저 제거 후 EmbeddedResource 로 포함. -->
    <None Remove="Resources\SKILL.en.md" />
    <None Remove="Resources\SKILL.ko.md" />
    <!-- WithCulture=false: .en/.ko 를 문화권으로 오인(위성 어셈블리로 분리)하지 않도록 강제. LogicalName 으로 고정 이름. -->
    <EmbeddedResource Include="Resources\SKILL.en.md" WithCulture="false" LogicalName="SKILL.en.md" />
    <EmbeddedResource Include="Resources\SKILL.ko.md" WithCulture="false" LogicalName="SKILL.ko.md" />
  </ItemGroup>

  <ItemGroup>
    <!-- 테스트 어셈블리에 internal 멤버(예: OpenAiConfig.Mask) 노출 -->
    <InternalsVisibleTo Include="AkkaGraphLoop.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- 빌드시 Akka 어셈블리를 통째로 포함(AOT/트림 제거 방지) -->
    <TrimmerRootAssembly Include="Akka" />
    <TrimmerRootAssembly Include="Akka.Streams" />
    <TrimmerRootAssembly Include="Newtonsoft.Json" />
    <TrimmerRootAssembly Include="System.Configuration.ConfigurationManager" />
  </ItemGroup>

  <!-- Kùzu 네이티브 라이브러리를 CLI 출력/게시 폴더에도 준비 -->
  <Import Project="..\..\native\Kuzu.targets" />

</Project>
