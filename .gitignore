# Build output
bin/
obj/
[Dd]ebug/
[Rr]elease/
artifacts/

# IDE
.idea/
.vs/
*.user

# Secrets — 실제 시크릿(.secret/*.json)은 제외, *.tmp 템플릿은 커밋 허용
.secret/*.json
!.secret/*.json.tmp
secrets.json

# Kùzu native library cache (downloaded at build time)
native/_cache/

# Test/coverage
[Tt]est[Rr]esult*/
coverage*.json
coverage*.xml
*.coverage

# npm packaging
node_modules/
# CI 가 조립하는 플랫폼 패키지(바이너리 포함) — 커밋 안 함
npm/platform/@webnori/
# 런처는 소스이므로 위 bin/ 규칙에서 되살린다
!npm/pdsa/bin/
!npm/pdsa/bin/pdsa.js
